#!/usr/bin/env bash
# Unload an agent
# USAGE: launcher unload <name|--all>
#
# COMPLETE:
#   1 _launcher_agent_names_or_all

set -euo pipefail
SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
source "$SCRIPT_DIR/lib-cli.bash" --auto-help "$@"
source "$SCRIPT_DIR/lib-plist.bash"
source "$SCRIPT_DIR/lib-launchd.bash"

_unload_one() {
  local name="$1"
  local plist
  plist="$(launcher_plist "$name")"

  if [[ -f "$plist" ]]; then
    launchctl unload "$plist" 2>/dev/null
    echo "Unloaded: $name"
    return 0
  fi

  local label="${LAUNCHER_PREFIX}.${name}"
  local uid
  uid="$(id -u)"

  # Dangling symlink: target (e.g. repo file behind a stow link) was
  # renamed/deleted but the link remains
  if [[ -L "$plist" ]]; then
    launchctl bootout "gui/${uid}/${label}" 2>/dev/null || launchctl remove "$label" 2>/dev/null || true
    rm "$plist"
    # Also remove the runner symlink if dangling
    local runner
    runner="$(launcher_bin "$name")"
    [[ -L "$runner" && ! -e "$runner" ]] && rm "$runner"
    echo "Unloaded (dangling): $name"
    return 0
  fi

  # Fallback: bootout orphaned loaded job
  if launcher_loaded_names | grep -Fxq "$name"; then
    if launchctl bootout "gui/${uid}/${label}" 2>/dev/null || launchctl remove "$label" 2>/dev/null; then
      echo "Unloaded: $name"
      return 0
    fi
    echo "Failed to unload loaded job: $name"
    return 1
  fi

  echo "Not found: $name"
  return 1
}

name="${1:-}"
[[ -z "$name" ]] && usage

if [[ "$name" == "--all" ]]; then
  for f in "$LAUNCHER_DIR"/${LAUNCHER_PREFIX}.*.plist; do
    [[ -f "$f" || -L "$f" ]] || continue
    n="$(basename "$f" .plist)"
    n="${n#${LAUNCHER_PREFIX}.}"
    _unload_one "$n"
  done
else
  _unload_one "$name" || exit 1
fi
