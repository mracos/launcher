#!/usr/bin/env bash
# Remove an agent (unload, delete plist and bin)
# USAGE: launcher rm <name>
#
# COMPLETE:
#   1 _launcher_agent_names

set -euo pipefail
SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
source "$SCRIPT_DIR/lib-cli.bash" --auto-help "$@"
source "$SCRIPT_DIR/lib-plist.bash"

name="${1:-}"
[[ -z "$name" ]] && usage

plist="$(launcher_plist "$name")"
if [[ ! -f "$plist" ]]; then
  echo "Not found: $name"
  exit 1
fi

bin="$(launcher_bin "$name")"
launchctl unload "$plist" 2>/dev/null || true
rm -f "$plist" "$bin"
echo "Removed: $name"
