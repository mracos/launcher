#!/usr/bin/env bash
# Run agent command manually
# USAGE: launcher run <name>
#
# COMPLETE:
#   1 _launcher_agent_names

set -euo pipefail
SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
source "$SCRIPT_DIR/lib-cli.bash" --auto-help "$@"
source "$SCRIPT_DIR/lib-plist.bash"

name="${1:-}"
[[ -z "$name" ]] && usage

bin="$(launcher_bin "$name")"
if [[ ! -f "$bin" ]]; then
  echo "Not found: $name"
  exit 1
fi

"$bin"
