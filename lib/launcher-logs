#!/usr/bin/env bash
# Show agent logs (follow with -f)
# USAGE: launcher logs <name> [-f]
#
# COMPLETE:
#   1 _launcher_agent_names

set -euo pipefail
SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
source "$SCRIPT_DIR/lib-cli.bash" --auto-help "$@"
source "$SCRIPT_DIR/lib-plist.bash"
source "$SCRIPT_DIR/lib-launchd.bash"

name="${1:-}"
[[ -z "$name" ]] && usage
default_log_path="${LAUNCHER_LOG_DIR:-$HOME/Library/Logs/launcher}/${name}.log"

follow=false
shift || true
[[ "${1:-}" == "-f" ]] && follow=true

plist="$(launcher_plist "$name")"
if [[ ! -f "$plist" ]]; then
  echo "Not found: $name"
  exit 1
fi

# Prefer launcher-managed log (written by bin/launcher-run); fall back to a
# plist-configured StandardOutPath for legacy/manual agents.
if [[ -f "$default_log_path" ]]; then
  stdout_path="$default_log_path"
else
  info="$(launcher_launchd_info "$name")"
  stdout_path="$(echo "$info" | grep "^stdout_path=" | cut -d= -f2-)"

  if [[ -z "$stdout_path" ]]; then
    stdout_path="$(/usr/libexec/PlistBuddy -c "Print :StandardOutPath" "$plist" 2>/dev/null || echo "")"
  fi
fi

if [[ -z "$stdout_path" ]]; then
  echo "No log path configured for $name"
  echo "Default location: ${default_log_path}"
  exit 1
fi

if [[ ! -f "$stdout_path" ]]; then
  echo "Log file not found: $stdout_path"
  exit 1
fi

if $follow; then
  tail -f "$stdout_path"
else
  tail -20 "$stdout_path"
fi
