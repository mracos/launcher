#!/usr/bin/env bash
# Re-enable a disabled agent and load it if linked
# USAGE: launcher enable <name|--all>
#
# COMPLETE:
#   1 _launcher_agent_names_or_all

set -euo pipefail
SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
source "$SCRIPT_DIR/lib-cli.bash" --auto-help "$@"
source "$SCRIPT_DIR/lib-plist.bash"

_enable_one() {
  local name="$1"
  local plist installed_plist label uid
  plist="$(launcher_plist "$name")"
  installed_plist="${LAUNCHER_INSTALL_DIR}/${LAUNCHER_PREFIX}.${name}.plist"
  label="${LAUNCHER_PREFIX}.${name}"
  uid="$(id -u)"

  if [[ ! -f "$plist" ]]; then
    echo "Not found: $name"
    return 1
  fi

  if ! launchctl enable "gui/${uid}/${label}" 2>/dev/null; then
    echo "Failed to enable: $name"
    return 1
  fi

  if [[ -f "$installed_plist" ]]; then
    launchctl load "$installed_plist" 2>/dev/null || true
    echo "Enabled: $name"
  else
    echo "Enabled: $name (not linked)"
  fi
}

name="${1:-}"
[[ -z "$name" ]] && usage

if [[ "$name" == "--all" ]]; then
  for f in "$LAUNCHER_DIR"/${LAUNCHER_PREFIX}.*.plist; do
    [[ -f "$f" ]] || continue
    n="${f##*/}"
    n="${n%.plist}"
    n="${n#${LAUNCHER_PREFIX}.}"
    _enable_one "$n"
  done
else
  _enable_one "$name" || exit 1
fi
