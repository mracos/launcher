#!/usr/bin/env bash
# Load an agent
# USAGE: launcher load <name|--all>
#
# COMPLETE:
#   1 _launcher_agent_names_or_all

set -euo pipefail
SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
source "$SCRIPT_DIR/lib-cli.bash" --auto-help "$@"
source "$SCRIPT_DIR/lib-plist.bash"

_load_one() {
  local name="$1"
  local plist
  plist="$(launcher_plist "$name")"

  if [[ ! -f "$plist" ]]; then
    echo "Not found: $name (no plist in $LAUNCHER_DIR)"
    return 1
  fi

  launchctl load "$plist" 2>/dev/null
  echo "Loaded: $name"
}

name="${1:-}"
[[ -z "$name" ]] && usage

if [[ "$name" == "--all" ]]; then
  for f in "$LAUNCHER_DIR"/${LAUNCHER_PREFIX}.*.plist; do
    [[ -f "$f" ]] || continue
    n="$(basename "$f" .plist)"
    n="${n#${LAUNCHER_PREFIX}.}"
    _load_one "$n"
  done
else
  _load_one "$name" || exit 1
fi
